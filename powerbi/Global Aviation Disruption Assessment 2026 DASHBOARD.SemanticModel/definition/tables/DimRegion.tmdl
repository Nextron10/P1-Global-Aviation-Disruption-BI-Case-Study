/// Unique values from the listed source populations.
table DimRegion
	lineageTag: 63ce4033-6bf2-41cf-97ee-4fe434b194dd

	column region
		dataType: string
		lineageTag: 657c8edc-d932-4e8a-a06f-8e6e600d29db
		summarizeBy: none
		sourceColumn: [region]

	partition DimRegion = calculated
		mode: import
		source =
				FILTER(DISTINCT(UNION(
				    SELECTCOLUMNS('aviation vw_airline_loss_summary', "region", 'aviation vw_airline_loss_summary'[region]),
				    SELECTCOLUMNS('aviation vw_airport_disruption', "region", 'aviation vw_airport_disruption'[region]),
				    SELECTCOLUMNS('aviation vw_airspace_closure', "region", 'aviation vw_airspace_closure'[region]),
				    SELECTCOLUMNS('aviation vw_regional_vulnerability', "region", 'aviation vw_regional_vulnerability'[region])
				)), NOT ISBLANK([region]))

