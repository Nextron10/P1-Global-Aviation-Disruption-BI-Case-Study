/// Continuous calendar from the dated facts. Financial facts are undated.
table DimDate
	lineageTag: d9bce6dc-cc68-4535-893b-1ef4f9cd5a1f
	dataCategory: Time

	column Date
		dataType: dateTime
		isKey
		formatString: dd MMM yyyy
		lineageTag: 89274c1d-0547-4104-92bc-b6a6f8ad291d
		summarizeBy: none
		sourceColumn: [Date]

	column Year = YEAR(DimDate[Date])
		dataType: int64
		lineageTag: 357b1273-be22-43e6-aaef-4230b66ef8ec
		summarizeBy: none

	column Month = FORMAT(DimDate[Date], "MMM")
		dataType: string
		lineageTag: 73e6ddac-2901-4ca4-a546-ea8851e2f43b
		summarizeBy: none
		sortByColumn: 'Month Number'

	column 'Month Number' = MONTH(DimDate[Date])
		dataType: int64
		lineageTag: 7470bbd6-2b30-4c55-b137-e269687ddf8a
		summarizeBy: none

	column 'Year Month' = FORMAT(DimDate[Date], "yyyy-MM")
		dataType: string
		lineageTag: 02de3f00-4d41-417c-8b77-6160c75fd2bf
		summarizeBy: none

	column Quarter = "Q" & FORMAT(DimDate[Date], "Q")
		dataType: string
		lineageTag: 47992c98-3ce9-48c4-8329-aefb4cd6faa1
		summarizeBy: none

	hierarchy 'Data Drill Hierarchy'
		lineageTag: 7d71d98a-aa38-44eb-9e1a-8219fed5d727

		level Year
			lineageTag: 32e74d65-1c0b-4375-ab9d-f1f1b345b2fc
			column: Year

		level Month
			lineageTag: 99331cf4-84fa-44bc-812c-155cc11247f8
			column: Month

		level Date
			lineageTag: 81594932-e9b7-4925-8508-bbf27bbc4c1f
			column: Date

	partition DimDate = calculated
		mode: import
		source =
				VAR AllDates = UNION(
				    SELECTCOLUMNS('aviation flight_cancellations', "Date", 'aviation flight_cancellations'[date]),
				    SELECTCOLUMNS('aviation flight_reroutes', "Date", 'aviation flight_reroutes'[date]),
				    SELECTCOLUMNS('aviation vw_airport_disruption', "Date", 'aviation vw_airport_disruption'[date]),
				    SELECTCOLUMNS('aviation conflict_events', "Date", 'aviation conflict_events'[date]),
				    SELECTCOLUMNS('aviation vw_airspace_closure', "Date", 'aviation vw_airspace_closure'[Closure Start Date]),
				    SELECTCOLUMNS('aviation vw_airspace_closure', "Date", 'aviation vw_airspace_closure'[Closure End Date])
				)
				RETURN CALENDAR(MINX(AllDates, [Date]), MAXX(AllDates, [Date]))

