/// One undated modeled row per source airline. Keep this population separate.
table 'aviation vw_airline_loss_summary'
	lineageTag: 16ffe7c3-06d4-48ed-baa4-0a076af57357

	column airline
		dataType: string
		lineageTag: 53af0596-876c-4e8c-9bff-ade87076c501
		summarizeBy: none
		sourceColumn: airline

	column country
		dataType: string
		lineageTag: 2c5f7799-7575-42a7-a259-b35990ac959c
		summarizeBy: none
		sourceColumn: country

	column airline_type
		dataType: string
		lineageTag: 4e7cfe42-62bf-4017-8da4-522423d5e093
		summarizeBy: none
		sourceColumn: airline_type

	column region
		dataType: string
		lineageTag: 4cb55bf7-92ac-4376-b4c9-ecced59deef8
		summarizeBy: none
		sourceColumn: region

	column estimated_loss_usd
		dataType: double
		lineageTag: 7fd28a4e-2525-4926-9de0-e283d2f5a80e
