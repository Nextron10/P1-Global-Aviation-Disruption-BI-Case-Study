table DimCountry
	lineageTag: 4c28bf25-c418-423f-a2f3-8f59d484c771

	column country
		lineageTag: 74a9758a-3c81-455a-b8f6-133ef2b094e9
		summarizeBy: none
		isNameInferred
		sourceColumn: [country]

		annotation SummarizationSetBy = Automatic

	partition DimCountry = calculated
		mode: import
		source =
				
				DISTINCT(
				    UNION(
				        SELECTCOLUMNS(
				            'aviation vw_airline_operational_financial',
				            "country",
				            'aviation vw_airline_operational_financial'[country]
				        ),
				        SELECTCOLUMNS(
				            'aviation vw_airport_disruption',
				            "country",
				            'aviation vw_airport_disruption'[country]
				        ),
				        SELECTCOLUMNS(
				            'aviation vw_airspace_closure',
				            "country",
				            'aviation vw_airspace_closure'[country]
				        )
				    )
				)

	annotation PBI_Id = 0e3f462bb0864259938611abc80fd7b6

