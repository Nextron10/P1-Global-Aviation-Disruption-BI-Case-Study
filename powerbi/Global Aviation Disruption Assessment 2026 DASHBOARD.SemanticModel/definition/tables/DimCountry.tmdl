/// Unique values from the listed source populations.
table DimCountry
	lineageTag: d0c3bf5f-85b6-4a3a-a783-f0e83f2520e9

	column country
		dataType: string
		lineageTag: ed1b1182-9083-4e4f-9f03-ab4fd4c5bccf
		summarizeBy: none
		sourceColumn: [country]

	partition DimCountry = calculated
		mode: import
		source =
				FILTER(DISTINCT(UNION(
				    SELECTCOLUMNS('aviation vw_airline_loss_summary', "country", 'aviation vw_airline_loss_summary'[country]),
				    SELECTCOLUMNS('aviation vw_airline_loss_estimate', "country", 'aviation vw_airline_loss_estimate'[country]),
				    SELECTCOLUMNS('aviation vw_airport_disruption', "country", 'aviation vw_airport_disruption'[country]),
				    SELECTCOLUMNS('aviation vw_airspace_closure', "country", 'aviation vw_airspace_closure'[country]),
				    SELECTCOLUMNS('aviation conflict_events', "country", 'aviation conflict_events'[country])
				)), NOT ISBLANK([country]))

