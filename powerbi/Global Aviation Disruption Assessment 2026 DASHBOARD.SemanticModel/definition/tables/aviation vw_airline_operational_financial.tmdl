table 'aviation vw_airline_operational_financial'
	lineageTag: 1054dfcf-0aab-4305-9cc1-6ae956494925

	measure 'Average Revenue Loss %' =
			
			AVERAGE(
			    'aviation vw_airline_operational_financial'[revenue_loss_pct]
			)
		lineageTag: 72267873-1528-418c-9aff-86d96d7e3633

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Cancellations per Rerouted Flight' =
			
			DIVIDE(
			    SUM('aviation vw_airline_operational_financial'[cancelled_flights]),
			    SUM('aviation vw_airline_operational_financial'[rerouted_flights])
			)
		lineageTag: cf8c543a-520a-4a2c-8d07-205ad2b08c89

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Fuel Cost per Rerouted Flight' =
			
			DIVIDE(
			    SUM(
			        'aviation vw_airline_operational_financial'[additional_fuel_cost_usd]
			    ),
			    SUM(
			        'aviation vw_airline_operational_financial'[rerouted_flights]
			    )
			)
		lineageTag: cb603e7c-ce44-456f-8916-554ef098137b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Financial Cancellations' =
			
			SUM(
			    'aviation vw_airline_operational_financial'[cancelled_flights]
			)
		formatString: 0
		lineageTag: f2906c95-cb07-4e2b-9fba-165e4f21df81

	measure 'Financial Fuel Cost' =
			
			SUM(
			    'aviation vw_airline_operational_financial'[additional_fuel_cost_usd]
			)
		formatString: 0
		lineageTag: 4939f0d4-b2db-4fd0-b235-5d65e5cb54ff

	measure 'Estimated Airline Loss' =
			
			SUM(
			    'aviation vw_airline_operational_financial'[estimated_loss_usd]
			)
		lineageTag: a4c669f9-c997-4a95-bc64-642a099b9fa6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Passengers per Rerouted Flight' =
			
			DIVIDE(
			    SUM('aviation vw_airline_operational_financial'[passengers_impacted]),
			    [Total Reroutes],
			    0
			)
		lineageTag: 17bcd046-cbb3-4aa9-89d7-b1abf870c90c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

