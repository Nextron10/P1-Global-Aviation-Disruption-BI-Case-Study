/// Unique values from the listed source populations.
table DimAirline
	lineageTag: 1d852127-e795-4ee9-805b-5180cf6ba59a

	column airline
		dataType: string
		lineageTag: 2aeb914c-1794-44ad-945a-08fea69aff00
		summarizeBy: none
		sourceColumn: [airline]

	partition DimAirline = calculated
		mode: import
		source =
				FILTER(DISTINCT(UNION(
				    SELECTCOLUMNS('aviation vw_airline_loss_summary', "airline", 'aviation vw_airline_loss_summary'[airline]),
				    SELECTCOLUMNS('aviation vw_airline_loss_estimate', "airline", 'aviation vw_airline_loss_estimate'[airline]),
				    SELECTCOLUMNS('aviation flight_cancellations', "airline", 'aviation flight_cancellations'[airline]),
				    SELECTCOLUMNS('aviation flight_reroutes', "airline", 'aviation flight_reroutes'[airline])
				)), NOT ISBLANK([airline]))

