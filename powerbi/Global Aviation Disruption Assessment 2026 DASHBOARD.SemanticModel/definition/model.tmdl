model Model
	culture: en-IN
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-IN
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["aviation vw_airline_loss_summary", "aviation vw_airline_loss_estimate", "aviation vw_airport_disruption", "aviation vw_airspace_closure", "aviation vw_geopolitical_daily_impact", "aviation vw_route_passenger_impact", "aviation vw_regional_vulnerability", "aviation flight_cancellations", "aviation flight_reroutes", "aviation conflict_events"]

annotation PBI_ProTooling = ["DevMode"]

ref table 'aviation vw_airline_loss_summary'
ref table 'aviation vw_airline_loss_estimate'
ref table 'aviation vw_airport_disruption'
ref table 'aviation vw_airspace_closure'
ref table 'aviation vw_geopolitical_daily_impact'
ref table 'aviation vw_route_passenger_impact'
ref table 'aviation vw_regional_vulnerability'
ref table 'aviation flight_cancellations'
ref table 'aviation flight_reroutes'
ref table 'aviation conflict_events'
ref table DimDate
ref table DimAirline
ref table DimCountry
ref table DimRegion
ref table DimAirportSeverity
ref table DimConflictSeverity
ref table DimOriginCountry
ref table DimDestinationCountry
ref table DimOriginRegion
ref table DimDestinationRegion
ref table 'Report Measures'
ref table 'Operational Factor'

ref cultureInfo en-IN

